# .streamlit/secrets.toml (Streamlit Community Cloud secrets)
# Copy this file to .streamlit/secrets.toml for local development,
# or paste these key-value pairs into the Streamlit Cloud dashboard.
# NEVER commit secrets.toml with real API keys to git.

GROQ_API_KEY         = "gsk_..."
OPENAI_API_KEY       = "sk-..."
REDDIT_CLIENT_ID     = "..."
REDDIT_CLIENT_SECRET = "..."
REDDIT_USER_AGENT    = "discovery-engine/1.0"
YOUTUBE_API_KEY      = "..."
SERP_API_KEY         = "..."
